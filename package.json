{
  "name": "cc-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build --target=bun --outdir dist src/server.ts",
    "start": "bun dist/server.js",
    "docker:build": "docker build -t cc-agent-sdk .",
    "docker:run": "docker run --rm -p ${AGENT_SDK_PORT:-20001}:20001 cc-agent-sdk"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.75"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^22.9.4",
    "typescript": "^5.7.2"
  }
}
