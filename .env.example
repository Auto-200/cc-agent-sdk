# Proxy server config (project-scoped)
AGENT_SDK_PORT=20001
AGENT_SDK_API_KEY=replace-with-a-strong-token

# Anthropic-compatible endpoint and keys (optional fallback; requests can override)
# 可选兜底：仅在请求未提供 apiKey/baseURL 时使用
ANTHROPIC_BASE_URL=https://api.gbro.site
ANTHROPIC_AUTH_TOKEN=replace-with-your-key

# Model defaults (optional fallback; used only when request doesn't pass model)
# 可选兜底：仅在请求未指定模型时使用
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-4.6
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-4.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.6
ANTHROPIC_MODEL=glm-4.6
ANTHROPIC_SMALL_FAST_MODEL=glm-4.6
# Optional fallback system prompt; used when request doesn't pass systemPrompt
# 可选兜底：仅在请求未指定 systemPrompt 时使用
ANTHROPIC_SYSTEM_PROMPT=You are a capable assistant agent. Be concise, accurate, and action-focused.
